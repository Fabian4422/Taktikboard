# Supabase (Pflicht für Speichern/Laden — in Vercel als Environment Variables setzen)
# URL MUSS mit https:// beginnen, ohne Anführungszeichen und ohne trailing slash.
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Optional: schützt /api/cron/keep-alive (Vercel Cron sendet Bearer automatisch, wenn gesetzt)
CRON_SECRET=change-me-to-a-long-random-string
